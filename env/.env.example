# Única plantilla comiteada. Para un flavor, copiá (sin subir a git):
#   cp env/.env.example env/.env.development
#   cp env/.env.example env/.env.staging
#   cp env/.env.example env/.env.production
# y ajustá valores. Si un archivo de flavor no existe, la app usa solo este `.example`.

API_BASE_URL=https://api-dev.example.com
# Opcional. Vacío = sin clave. Las claves de cliente nunca son totalmente privadas.
API_KEY=
# true = log de red (Dio); en producción usá false en el .env de ese flavor o defines en build.
ENABLE_NETWORK_LOGGING=true
